# Parretto DisplayPort RX (prt_dprx_top) in gateau notation v1.1
# Modelled by hand from gateware/src/rx/*.sv. Structure only; no code reproduced.
# Defaults: P_LANES = 4, P_SPL = 2, P_PPC = 2, P_BPC = 8, P_SDP and P_MST set.

design dprx
  params   P_LANES = 4, P_SPL = 2, P_PPC = 2, P_BPC = 8, P_SDP, P_MST
  axes     ℓ = P_LANES, s = P_SPL
  domains  lnk_clk (main), vid_clk, sdp_clk, sys_clk
  outside  PHY       # SERDES + 8b/10b decode: delivers k + 8b per symbol
  outside  PM        # policy maker: RISC-V hart, AUX, HPD, host bus (sys_clk)

# ── modes ────────────────────────────────────────────────────────────────
mode training      # cfg_tps ≠ 0: PM runs clock recovery (TPS1) and equalisation (TPS2/3/4)
mode normal        # cfg_tps = 0: main stream video, MSA, SDP

# ── carriers ─────────────────────────────────────────────────────────────
carrier sym   "one symbol group per lnk_clk"        @ lnk_clk   rate fixed
carrier msg   "16-bit message, routed by ID"        @ lnk_clk   ring
carrier pix   "P_PPC pixels per vid_clk"            @ vid_clk
carrier sdpk  "secondary data packet"               @ sdp_clk
carrier sdpb  "32-bit SDP beat"  ⊂ sdpk             @ sdp_clk

# ── fields ───────────────────────────────────────────────────────────────
field sym.k     : bit[ℓ,s]
field sym.dat   : u8[ℓ,s]
field sym.lock  : bit
group sym.tag   : { sol, eol, vid, sdp, msa, vbid } : bit[ℓ,s]

field pix.data  : u{P_BPC}[P_PPC, 3]
field pix.sof, pix.eol : bit
field sdpk.len  : u6                  availability tail
field sdpb.dat  : u32

# ── state ────────────────────────────────────────────────────────────────
state cfg      out-of-flow  { lnk_en, lanes, scrm_en, mst_en, bpc }  written by CTL from msg
state cfg_tps  out-of-flow  u3                                     written by TRN from msg
state ila      in-flow      per-lane interlane-align lock           written by TRN.ila
state msa_ram  in-flow      32 × u8                                 written by MSA
state vcfg     out-of-flow  { hwidth, … }                           written by VID from msg (vid_clk)

# ── boundaries (named; stages sit between them) ──────────────────────────
boundary b0                    # TRN output, lanes aligned
boundary b1 = b0 + 1           # PARS and SCRM outputs

# ── stages, in flow order ────────────────────────────────────────────────
stage CTL   on msg;  writes cfg

stage TRN   ×ℓ  on sym
            chk: reads k, dat; compares to pattern cfg_tps;  reports match → msg     in training
            ila: aligns lanes, lane 0 is master;  writes ila;  writes k, dat
            taps msg (cfg_tps in, status out)

fork  raw = { sym.k, sym.dat }

stage PARS  on sym;  between b0 → b1;  reads raw[ℓ = 0];  creates tag.*
            requires ila (lanes aligned, so lane 0 stands for all)
            writes lock := cfg.lnk_en
stage SCRM  ×ℓ  on sym;  between b0 → b1;  writes k, dat (descramble)
            writes lock := ∧ℓ over cfg.lanes;  reads cfg.mst_en
            enable tied to 1                                            # cfg.scrm_en not read
stage TAGB  on sym;  broadcast tag.*: bit[s] → bit[ℓ,s]                # lane-0 tags copied to every lane

join  lat(PARS, SCRM)              # by construction: both b0 → b1
                                   # RTL evidence: comments at pars.sv:1394, scrm.sv:128

stage MSA   on sym;  reads k, dat, tag.msa;  consumes tag.msa;  writes msa_ram
            emits attributes → msg;  reads cfg.lanes
stage SDP   if P_SDP;  on sym → sdpk;  reads k, dat, tag.sdp;  consumes tag.sdp
            data FIFO 32 words, length FIFO 8 words;  boundary lnk_clk → sdp_clk
            creates sdpk.len (tail);  creates sdpb.dat
            snoops VSC packets → msg
join  fifo(SDP.data, SDP.len)      # length leaves after its packet, matched in order

stage VID   on sym → pix
            lclk: reads sol, eol, vid, vbid, k, dat;  consumes all of sym
                  vbid → LNK_VBID_OUT, irq at end of vblank → PM
            lmap: reshape ℓ·s → stripes (4 stripes × 4 segments)
            fifo: 64 words;  boundary lnk_clk → vid_clk
            vmap: reshape stripes → pix.data;  reads cfg.bpc, vcfg
            creates pix.data, pix.sof, pix.eol

# ── coupling and domains ─────────────────────────────────────────────────
boundary PHY  → TRN        rigid                # the link cannot be stalled
boundary b0, b1            rigid
boundary *    → VID.fifo   rigid
boundary VID.fifo → out    elastic (VID_RDY_IN)  @ vid_clk
boundary SDP.fifo → out    @ sdp_clk
boundary msg ↔ PM          cdc lnk_clk ↔ sys_clk;  msg → VID cdc lnk_clk → vid_clk

# ── feedback ─────────────────────────────────────────────────────────────
feedback data  SCRM.out → TRN.chk                in training (TPS4 is checked descrambled)
feedback ctrl  TRN.chk  → PM via msg             training status (match, cycles)
feedback ctrl  PM → CTL, TRN via msg             cfg and cfg_tps (the training loop runs through the PM)
feedback ctrl  VID.irq  → PM                     stable-video detection

# ── checks (derived) ─────────────────────────────────────────────────────
check join lat(PARS, SCRM)       structural (b0 → b1)   RTL agreement held only by comment
check index raw[ℓ = 0]           requires ila       holds if TRN alignment is locked first
check state cfg.scrm_en          written, never read            → flag
check rigid  * → VID.fifo        no stall path into the link    → depth must cover the clock-rate gap
check rigid  * → SDP.fifo        same                           → 32 words per packet in flight
check cost   tag.* after TAGB    48 b carried, 12 b distinct    → 36 b of lane copies per stage
